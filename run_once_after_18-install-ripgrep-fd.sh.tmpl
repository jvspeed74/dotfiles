#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
brew install ripgrep fd

rg --version >/dev/null || { echo "ripgrep not runnable after install" >&2; exit 1; }
fd --version >/dev/null || { echo "fd not runnable after install" >&2; exit 1; }
