#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

brew_bin="{{ template "brew-prefix" . }}/bin/brew"

{{ if eq .chezmoi.os "linux" -}}
# Homebrew's documented Linux prerequisites.
sudo -v
sudo apt-get update
sudo apt-get install -y build-essential procps curl file git

if [[ ! -x "$brew_bin" ]]; then
    # NONINTERACTIVE skips the "press RETURN" prompt; sudo is already cached by `sudo -v` above.
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ else -}}
if [[ ! -x "$brew_bin" ]]; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ end -}}
eval "$("$brew_bin" shellenv)"
command -v brew >/dev/null || { echo "Homebrew install failed" >&2; exit 1; }
