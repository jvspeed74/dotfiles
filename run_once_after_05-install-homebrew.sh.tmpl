{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
set -euo pipefail
# macOS only: renders empty on Linux, so chezmoi skips it. Linux tools come from GitHub releases
# (.chezmoidata/linux-tools.toml) and apt; Homebrew's hosts are blocked on the corporate network.

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
export HOMEBREW_NO_ANALYTICS=1
{{ end -}}

brew_bin="{{ template "brew-prefix" . }}/bin/brew"
if [[ ! -x "$brew_bin" ]]; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$("$brew_bin" shellenv)"
command -v brew >/dev/null || { echo "Homebrew install failed" >&2; exit 1; }
{{ if .is_corporate -}}
# Persisted in Homebrew's own config, so it also covers brew runs from shells and other scripts.
brew analytics off
{{ end -}}
{{ end -}}
