#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

export NVM_DIR="$HOME/.nvm"
# Git install (nvm README): raw.githubusercontent.com, where install.sh lives, is blocked on some
# corporate networks; github.com over git is not. The installer also edited ~/.zshrc; this does not.
[[ -s "$NVM_DIR/nvm.sh" ]] || git clone --quiet --depth 1 --branch v0.40.1 https://github.com/nvm-sh/nvm.git "$NVM_DIR"
[[ -s "$NVM_DIR/nvm.sh" ]] || { echo "nvm clone failed" >&2; exit 1; }
# shellcheck disable=SC1091
\. "$NVM_DIR/nvm.sh"
# Only on a machine with no Node: this script re-runs when its content changes, and a fresh
# `nvm install --lts` there would switch new shells to a newer LTS without its global packages.
compgen -G "$NVM_DIR/versions/node/v*" >/dev/null || nvm install --lts

command -v node >/dev/null || { echo "nvm/node install failed" >&2; exit 1; }
node --version >/dev/null || { echo "node did not report a version" >&2; exit 1; }
