{{- /* Bash function for Linux install scripts; render with {{ template "install-release" . }}. */ -}}
# install_release NAME TAG URL SHA256 BIN...: download a pinned release asset, verify its sha256,
# unpack it into ~/.local/opt/NAME/TAG and link each BIN (a path inside the archive; for a .gz, the
# name to decompress to) into ~/.local/bin. Same TAG again: only the links are refreshed. A new
# TAG replaces the old one. Nothing is installed or linked if the checksum does not match.
install_release() {
    local name=$1 tag=$2 url=$3 sha=$4
    shift 4
    local base="$HOME/.local/opt/$name"
    local dest="$base/$tag" tmp bin
    [[ -n "$name" && -n "$tag" && $# -gt 0 ]] || { echo "install_release: usage: NAME TAG URL SHA256 BIN..." >&2; return 1; }
    [[ "$(uname -m)" == x86_64 ]] || { echo "install_release: $name: only x86_64 Linux is supported" >&2; return 1; }
    mkdir -p "$base" "$HOME/.local/bin"
    if [[ ! -d "$dest" ]]; then
        # Staging under $base, so the final mv is a rename on the same filesystem.
        tmp=$(mktemp -d "$base/.staging-XXXXXX")
        curl -fsSL --retry 3 -o "$tmp/download" "$url" || { rm -rf "$tmp"; echo "install_release: $name: download failed: $url" >&2; return 1; }
        echo "$sha  $tmp/download" | sha256sum -c --quiet - >/dev/null 2>&1 \
            || { rm -rf "$tmp"; echo "install_release: $name $tag: sha256 mismatch for $url" >&2; return 1; }
        mkdir "$tmp/root"
        case "$url" in
            *.tar.gz | *.tgz) tar -xzf "$tmp/download" -C "$tmp/root" ;;
            *.gz) gzip -dc "$tmp/download" > "$tmp/root/$1" && chmod +x "$tmp/root/$1" ;;
            *) rm -rf "$tmp"; echo "install_release: $name: unsupported archive: $url" >&2; return 1 ;;
        esac
        mv "$tmp/root" "$dest"
        rm -rf "$tmp"
    fi
    for bin in "$@"; do
        [[ -x "$dest/$bin" ]] || { echo "install_release: $name $tag has no executable $bin" >&2; return 1; }
        ln -sfn "$dest/$bin" "$HOME/.local/bin/${bin##*/}"
    done
    # Older versions and leftover staging dirs of this tool.
    find "$base" -mindepth 1 -maxdepth 1 ! -name "$tag" -exec rm -rf {} +
}
