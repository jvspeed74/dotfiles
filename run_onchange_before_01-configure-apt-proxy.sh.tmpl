#!/usr/bin/env bash
set -euo pipefail

{{ if and .is_corporate (eq .chezmoi.os "linux") -}}
# Hosts in apt's sources that resolve to a private address (an internal apt mirror): apt
# reaches those directly, since the corporate proxy may not route to internal hosts.
# Public hosts, Ubuntu's or third parties', stay on the proxy. $1 overrides /etc/apt (CI tests).
apt_direct_hosts() {
    local dir=${1:-/etc/apt} f host addr
    for f in "$dir"/sources.list "$dir"/sources.list.d/*.list "$dir"/sources.list.d/*.sources; do
        [[ -f "$f" ]] || continue
        awk '
            /^[[:space:]]*#/ { next }
            /^[[:space:]]*deb(-src)?[[:space:]]/ { sub(/\[[^]]*\]/, ""); print $2; next }
            /^[[:space:]]*URIs:/ { for (i = 2; i <= NF; i++) print $i }
        ' "$f"
    done | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#[:/].*$##' | sort -u | while IFS= read -r host; do
        # A host that does not resolve is not DIRECT (and must not abort under set -e/pipefail).
        addr=$(getent ahostsv4 "$host" 2>/dev/null | awk 'NR == 1 { print $1 }') || addr=

        if [[ "$addr" =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.) ]]; then echo "$host"; fi
    done
}

# Sourced by CI to test apt_direct_hosts; stop before touching the system.
[[ "${APT_PROXY_FUNCTIONS_ONLY:-}" == 1 ]] && return 0

# `sudo -v` prompts unless credentials are cached or every matching sudoers rule is NOPASSWD.
sudo -n true 2>/dev/null || sudo -v

PROXY_URL={{ .corporate_proxy_url | quote }}
if [[ -z "$PROXY_URL" ]]; then
    echo "corporate_proxy_url is empty; skipping apt proxy config." >&2
    exit 1
fi

direct_hosts=$(apt_direct_hosts)
{
    echo "Acquire::http::Proxy \"${PROXY_URL}\";"
    echo "Acquire::https::Proxy \"${PROXY_URL}\";"
    for host in $direct_hosts; do
        echo "Acquire::http::Proxy::${host} \"DIRECT\";"
        echo "Acquire::https::Proxy::${host} \"DIRECT\";"
    done
} | sudo tee /etc/apt/apt.conf.d/95corporate-proxy >/dev/null

grep -q "$PROXY_URL" /etc/apt/apt.conf.d/95corporate-proxy || {
    echo "apt proxy config file did not write as expected" >&2
    exit 1
}
echo "apt proxy configured${direct_hosts:+; direct (internal mirror): $(echo $direct_hosts)}."
{{ else -}}
exit 0
{{ end -}}
