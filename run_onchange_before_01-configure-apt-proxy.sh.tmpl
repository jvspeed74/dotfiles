#!/usr/bin/env bash
set -euo pipefail

{{ if and .is_corporate (eq .chezmoi.os "linux") -}}
sudo -v

PROXY_URL={{ .corporate_proxy_url | quote }}
if [[ -z "$PROXY_URL" ]]; then
    echo "corporate_proxy_url is empty; skipping apt proxy config." >&2
    exit 1
fi

sudo tee /etc/apt/apt.conf.d/95corporate-proxy >/dev/null <<EOF
Acquire::http::Proxy "${PROXY_URL}";
Acquire::https::Proxy "${PROXY_URL}";
EOF

grep -q "$PROXY_URL" /etc/apt/apt.conf.d/95corporate-proxy || {
    echo "apt proxy config file did not write as expected" >&2
    exit 1
}
echo "apt proxy configured."
{{ else -}}
exit 0
{{ end -}}
