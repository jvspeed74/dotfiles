#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
brew install gh

command -v gh >/dev/null || { echo "gh not on PATH after install" >&2; exit 1; }
gh --version >/dev/null || { echo "gh binary did not run" >&2; exit 1; }
