# Read by every zsh, including non-interactive ones (e.g. `wsl.exe <cmd>`), unlike .zshrc.

# PATH additions go through _dotfiles_path_prepend: it prepends only dirs not already on PATH, in
# argument order, so a nested zsh keeps its parent's order (e.g. an activated venv stays first).
# -U keeps the first copy of each entry; it needs both names, since a plain `typeset -U path` does
# not dedup assignments to the scalar PATH (macOS login shells in .zshrc still assign it).
typeset -U path PATH
_dotfiles_path_prepend() { local d; for d in ${(Oa)@}; do (( ${path[(Ie)$d]} )) || path=("$d" $path); done }
{{- if .is_corporate }}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
export http_proxy={{ .corporate_proxy_url | quote }}
export https_proxy={{ .corporate_proxy_url | quote }}
# Node and uv ship their own root CAs and ignore the system store by default.
{{- if eq .chezmoi.os "darwin" }}
export NODE_EXTRA_CA_CERTS={{ .corporate_ca_cert_source_path | quote }}
{{- else }}
export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corporate-root-ca.crt
{{- end }}
export UV_SYSTEM_CERTS=1
# .NET CLI telemetry is on by default; off on corporate machines, like Homebrew analytics.
export DOTNET_CLI_TELEMETRY_OPTOUT=1
{{- end }}

# rustup is installed with --no-modify-path; this file owns the cargo env line.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
{{- if eq .chezmoi.os "linux" }}

# Homebrew (Linux). Here rather than .zshrc so non-interactive shells (`wsl.exe <cmd>`, `zsh -c`)
# find brew tools too; the last line of this file puts ~/.local/bin ahead. shellenv prepends
# unconditionally, so skip it when Homebrew is already on PATH (a nested shell).
[[ -x {{ template "brew-prefix" . }}/bin/brew ]] && (( ! ${path[(Ie){{ template "brew-prefix" . }}/bin]} )) && eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
{{- end }}

# Editor and dev tools. Absolute Homebrew paths, so these also work on macOS, where .zshenv runs
# before .zshrc puts Homebrew on PATH.
[[ -x {{ template "brew-prefix" . }}/bin/nvim ]] && export EDITOR={{ template "brew-prefix" . }}/bin/nvim VISUAL={{ template "brew-prefix" . }}/bin/nvim
[[ -d {{ template "brew-prefix" . }}/opt/dotnet/libexec ]] && export DOTNET_ROOT={{ template "brew-prefix" . }}/opt/dotnet/libexec
# libpq is keg-only (not linked into bin), so add its bin for psql.
[[ -d {{ template "brew-prefix" . }}/opt/libpq/bin ]] && _dotfiles_path_prepend {{ template "brew-prefix" . }}/opt/libpq/bin

# Newest nvm-installed Node on PATH for every zsh (node, npm, mmdc, Mason's npm servers); the nvm
# command itself loads on first use in .zshrc. n = numeric sort, so v24.21.0 beats v24.9.0. Skipped
# when an nvm Node is already on PATH, so a child shell keeps its parent's `nvm use` choice.
export NVM_DIR="$HOME/.nvm"
_nvm_bins=( $NVM_DIR/versions/node/v*/bin(N/nOn) )
(( $#_nvm_bins && ! ${path[(I)$NVM_DIR/versions/node/*/bin]} )) && _dotfiles_path_prepend $_nvm_bins[1]
unset _nvm_bins

# ~/.local/bin (the only user bin dir) ahead of Homebrew, libpq, and system dirs in every fresh
# zsh, so `wsl.exe chezmoi …` and `zsh -c uv …` resolve. Last in this file so it precedes them.
_dotfiles_path_prepend "$HOME/.local/bin"
