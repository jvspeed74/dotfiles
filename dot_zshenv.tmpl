# Read by every zsh, including non-interactive ones (e.g. `wsl.exe <cmd>`), unlike .zshrc.
{{- if .is_corporate }}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
export http_proxy={{ .corporate_proxy_url | quote }}
export https_proxy={{ .corporate_proxy_url | quote }}
# Node and uv ship their own root CAs and ignore the system store by default.
{{- if eq .chezmoi.os "darwin" }}
export NODE_EXTRA_CA_CERTS={{ .corporate_ca_cert_source_path | quote }}
{{- else }}
export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corporate-root-ca.crt
{{- end }}
export UV_SYSTEM_CERTS=1
# .NET CLI telemetry is on by default; off on corporate machines, like Homebrew analytics.
export DOTNET_CLI_TELEMETRY_OPTOUT=1
{{- end }}

# rustup is installed with --no-modify-path; this file owns the cargo env line.
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
{{- if eq .chezmoi.os "linux" }}

# Homebrew (Linux). Here rather than .zshrc so non-interactive shells (`wsl.exe <cmd>`, `zsh -c`)
# find brew tools too; the user-bin PATH export at the end of this file puts ~/.local/bin ahead.
[[ -x {{ template "brew-prefix" . }}/bin/brew ]] && eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
{{- end }}

# Editor and dev tools. Absolute Homebrew paths, so these also work on macOS, where .zshenv runs
# before .zshrc puts Homebrew on PATH.
[[ -x {{ template "brew-prefix" . }}/bin/nvim ]] && export EDITOR={{ template "brew-prefix" . }}/bin/nvim VISUAL={{ template "brew-prefix" . }}/bin/nvim
[[ -d {{ template "brew-prefix" . }}/opt/dotnet/libexec ]] && export DOTNET_ROOT={{ template "brew-prefix" . }}/opt/dotnet/libexec
# libpq is keg-only (not linked into bin), so add its bin for psql.
[[ -d {{ template "brew-prefix" . }}/opt/libpq/bin && ":$PATH:" != *":{{ template "brew-prefix" . }}/opt/libpq/bin:"* ]] && export PATH="{{ template "brew-prefix" . }}/opt/libpq/bin:$PATH"

# User bins first in every zsh, so `wsl.exe chezmoi …` and `zsh -c uv …` resolve. Last in this file
# so they precede Homebrew and libpq. .zshrc prepends the same dirs again for interactive shells
# (macOS path_helper reorders PATH in between). -U keeps the first copy of each entry; it needs
# both names, since a plain `typeset -U path` does not dedup assignments to the scalar PATH.
typeset -U path PATH
export PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:$PATH"
