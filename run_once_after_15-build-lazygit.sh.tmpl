#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
brew install lazygit
{{ else -}}
workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT

git clone --depth 1 https://github.com/jesseduffield/lazygit.git "$workdir/lazygit"
( cd "$workdir/lazygit" && go build -o lazygit . )
mkdir -p "$HOME/.local/bin"
mv "$workdir/lazygit/lazygit" "$HOME/.local/bin/lazygit"
{{ end -}}

command -v lazygit >/dev/null || { echo "lazygit not on PATH after install" >&2; exit 1; }
lazygit --version >/dev/null || { echo "lazygit binary did not run" >&2; exit 1; }
