#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
{{ end -}}

# after_05's shellenv ran in its own process; brew is not on this script's PATH on a fresh machine.
eval "$({{ template "brew-prefix" . }}/bin/brew shellenv)"
brew install lazygit
{{ if eq .chezmoi.os "linux" -}}
# Remove the binary an earlier Go source build left; ~/.local/bin precedes Homebrew in PATH.
rm -f "$HOME/.local/bin/lazygit"
{{ end -}}

command -v lazygit >/dev/null || { echo "lazygit not on PATH after install" >&2; exit 1; }
lazygit --version >/dev/null || { echo "lazygit binary did not run" >&2; exit 1; }
