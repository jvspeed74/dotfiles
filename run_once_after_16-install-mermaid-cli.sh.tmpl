#!/usr/bin/env bash
set -euo pipefail

{{ if .is_corporate -}}
export HTTP_PROXY={{ .corporate_proxy_url | quote }}
export HTTPS_PROXY={{ .corporate_proxy_url | quote }}
# chezmoi runs this under bash, so ~/.zshenv's NODE_EXTRA_CA_CERTS is not inherited.
{{ if eq .chezmoi.os "darwin" -}}
export NODE_EXTRA_CA_CERTS={{ .corporate_ca_cert_source_path | quote }}
{{ else -}}
export NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/corporate-root-ca.crt
{{ end -}}
{{ end -}}

export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
\. "$NVM_DIR/nvm.sh"

npm install -g @mermaid-js/mermaid-cli
# @puppeteer/browsers honors HTTP(S)_PROXY only when proxy-agent is installed (pptr.dev/browsers-api).
npx -p puppeteer -p proxy-agent puppeteer browsers install chrome-headless-shell

command -v mmdc >/dev/null || { echo "mermaid-cli install failed" >&2; exit 1; }
mmdc --version >/dev/null || { echo "mmdc did not report a version" >&2; exit 1; }
